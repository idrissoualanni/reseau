# Copier vers .env.local ; sur Render : environment groups (dev / production). Jamais de vraies valeurs commitées.
# --- Neon (Postgres) ---
DATABASE_URL=            # poolée (runtime)
DATABASE_URL_UNPOOLED=   # directe (migrations)
# --- Neon Auth (console Neon > Auth) ---
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# --- Neon Storage (S3-compatible) ---
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=images
STORAGE_PUBLIC_BASE_URL=  # domaine de lecture des images
# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# --- Développement (MCP/CI) ---
RENDER_API_KEY=          # clé Render : jamais affichée, jamais commitée