# Copier vers .env.local ; sur Render : environment groups (dev / production). Jamais de vraies valeurs commitées.
# --- Neon (Postgres) ---
DATABASE_URL=            # poolée (runtime)
DATABASE_URL_UNPOOLED=   # directe (migrations)
# --- Neon Auth (console Neon > Auth) ---
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# --- Neon Object Storage (S3-compatible) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_ENDPOINT_URL_S3=
# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# --- Neon Realtime (V2) ---
# URL wss:// de la branche ; le secret reste serveur et n'est jamais exposé.
NEON_REALTIME_URL=
# Même URL, exposée au navigateur (client Realtime).
NEXT_PUBLIC_NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
# --- Cloudflare Turnstile (désactivé, voir docs/TODO.md) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# --- Développement (MCP/CI) ---
RENDER_API_KEY=          # clé Render : jamais affichée, jamais commitée