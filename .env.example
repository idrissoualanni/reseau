DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Application ─────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:3000/api/graphql

# ── Authentification (noms à adapter à la librairie choisie) ─
AUTH_SECRET=

# ── WebRTC ──────────────────────────────────────────────────

NEXT_PUBLIC_SIGNALING_URL=ws://localhost:4000
NEXT_PUBLIC_STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── E-mails (vérification de compte, notifications) ─────────
EMAIL_API_KEY=
EMAIL_FROM=

# ── Stockage de fichiers (photos de profil, documents) ──────
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ════════════════════════════════════════════════════════════
# HORS DU DÉPÔT — à mettre dans ton shell (~/.bashrc, ~/.zshrc), pas dans .env.local
# ════════════════════════════════════════════════════════════
# Clé d'API Render, lue par le MCP Render (Claude Code et OpenCode).
# RENDER_API_KEY=
# Clé d'API Neon : uniquement si tu utilises le MCP Neon en local au lieu de l'OAuth.
# NEON_API_KEY=

# Pas de clé de chiffrement des messages ici : le chiffrement E2E se fait sur
# l'appareil, aucune clé privée ne doit exister côté serveur.
