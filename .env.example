# Copier vers .env.local (local) ; sur Render : utiliser les environment groups (dev / production). Ne jamais committer de vraies valeurs.
# --- Neon (Postgres) ---
DATABASE_URL=            # connexion poolée (runtime)
DATABASE_URL_UNPOOLED=   # connexion directe (migrations drizzle-kit)
# --- Neon Auth (voir console Neon > Auth) ---
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=  # à adapter selon la doc Neon Auth en vigueur
# --- Neon Storage (S3-compatible) — noms à confirmer dans la doc Neon ---
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=images
STORAGE_PUBLIC_BASE_URL=  # base d'URL de lecture des images (bucket public_read ou domaine Cloudflare)
# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# --- Cloudflare Turnstile (anti-robot à l'inscription) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
