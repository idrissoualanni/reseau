{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".claude/rules/*.md"],
  "mcp": {
    "servers": {
      "agentation": {
        "type": "local",
        "command": ["npx", "-y", "agentation-mcp", "server"]
      },
      "neon": {
        "type": "remote",
        "url": "https://mcp.neon.tech/mcp"
      },
      "render": {
        "type": "remote",
        "url": "https://mcp.render.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:.secrets/render-api-key}"
        }
      }
    }
  }
}
